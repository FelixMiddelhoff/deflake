<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>deflake</AssemblyName>
    <RootNamespace>Deflake</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>deflake</ToolCommandName>
    <PackageId>Deflake</PackageId>
    <Description>Finds out why a test is flaky: reruns it under controlled conditions and names the factor that flips the result.</Description>
    <PackageTags>flaky-tests;test-flakiness;xunit;nunit;mstest;dotnet-tool;debugging;root-cause-analysis;delta-debugging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FelixMiddelhoff/deflake</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deflake.Core\Deflake.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
